# =========================
# SPRING PROFILE
# =========================
SPRING_PROFILES_ACTIVE=dev

# =========================
# DATABASE (DEV - H2 not needed here, but keep placeholder if switching)
# =========================
SPRING_DATASOURCE_URL=jdbc:h2:mem:probeapi_db
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# =========================
# JWT CONFIG
# =========================
JWT_SECRET=dev-secret-key-very-long-at-least-32-characters
JWT_EXPIRATION=86400000

# =========================
# SERVER CONFIG
# =========================
PORT=8080